# OKF Cross-Agent Knowledge Exchange — environment template.
#
# Copy to .env for LOCAL DEVELOPMENT ONLY (.env is gitignored; this file
# is the committed template). In production, set real environment
# variables instead. NEVER commit a real .env.
#
# Architecture rule: Producer, Consumer A, and Consumer B are independent
# components. They share nothing but the okf/ bundle directory — no code,
# no database, no LLM provider coupling. Each component reads only its own
# settings and only needs the API key for the provider it is configured
# to use.

# ---------- Search (Producer only) ----------
TAVILY_API_KEY=

# ---------- LLM API keys ----------
# Required by any component whose LLM provider is "groq".
GROQ_API_KEY=
# Required by any component whose LLM provider is "openai".
OPENAI_API_KEY=

# ---------- Producer (Python) ----------
# Supported providers: groq | openai. Model defaults to the provider's
# default (llama-3.3-70b-versatile for groq, gpt-4o for openai).
OKF_PRODUCER_LLM_PROVIDER=groq
OKF_PRODUCER_MODEL=llama-3.3-70b-versatile
OKF_LOOKBACK_DAYS=7
OKF_MAX_RESULTS=5
OKF_REQUEST_TIMEOUT=30

# ---------- Consumer A (Briefing Agent, Python — M3) ----------
# Deliberately independent from Consumer B; reads okf/ only.
# Switching provider/model never requires code changes.
OKF_CONSUMER_A_PROVIDER=groq
OKF_CONSUMER_A_MODEL=llama-3.3-70b-versatile

# ---------- Consumer B (Devil's Advocate, Node.js — M4) ----------
# Deliberately a different LLM provider from Consumer A by design.
OKF_CONSUMER_B_PROVIDER=openai
OKF_CONSUMER_B_MODEL=gpt-5.5

# ---------- Shared paths & logging ----------
# Paths relative to the component working directory are fine.
OKF_BUNDLE_PATH=okf
OKF_REGISTRY_PATH=config/tracked_concepts.yaml
OKF_LOG_LEVEL=INFO
